architecture right
appearance: paper
icons: off
group build = "01 · Build advisor" [pin: "0,0"] {
  corpus = "Source corpus" [icon: tabler/books, iconpos: left, gray, outline, desc: "Literature + recorded views", pin: "20,42"]
  profile = "Grounded profile" [icon: tabler/user-circle, iconpos: left, gray, outline, desc: "Each claim linked to a source", pin: "20,192"]
  curator = "Curator promotion" [icon: tabler/user-check, iconpos: left, "#e4f17c", bold, desc: "Depth gate before critique", pin: "20,342"]
}
group converse = "02 · Converse" [pin: "297,0"] {
  chat = "Advisor conversation" [icon: tabler/message-circle, iconpos: left, "#14543c", bold, desc: "Hedged on thin evidence", pin: "20,42"]
  deck = "Deck attached" [icon: tabler/presentation, iconpos: left, gray, outline, desc: "Added mid-conversation", pin: "20,192"]
}
group critique = "03 · Critique and verify" [pin: "584,0"] {
  draft = "Draft critique" [icon: tabler/file-text, iconpos: left, "#14543c", bold, desc: "Points tied to slides", pin: "20,42"]
  verify = "Independent check" [icon: tabler/shield-check, iconpos: left, "#14543c", bold, desc: "Separate pass tests each point", pin: "20,192"]
  supported = "Supported?" [diamond, "#e4f17c", bold, width: 150, height: 88, pin: "67,342"]
  gap = "State the gap" [gray, outline, desc: "Abstain; never fill it in", pin: "48,492"]
}
group share = "04 · Share" [pin: "898,0"] {
  readout = "Critique readout" [icon: tabler/file-search, iconpos: left, "#14543c", bold, desc: "Verdict + slide basis", pin: "20,42"]
  html = "Standalone page" [icon: tabler/world, iconpos: left, gray, outline, desc: "Readable without the app", pin: "20,192"]
  pptx = "Annotated deck" [icon: tabler/presentation, iconpos: left, gray, outline, desc: "Comments on the slides", pin: "20,342"]
  handoff = "Copy-first handoff" [icon: tabler/copy, iconpos: left, gray, outline, desc: "Planned; labelled unverified", pin: "20,492"]
}
corpus -> profile
profile -> curator
curator -> chat : promoted [from: right, to: left]
chat -> deck
deck -> draft : slides [from: right, to: left]
draft -> verify
verify -> supported
supported -> readout : supported [from: right, to: left]
supported -> gap : no
gap --> draft : revise once [from: left, to: left]
readout -> html
readout -> pptx [from: right, to: right]
readout -> handoff [from: right, to: right]
handoff --> corpus : planned expert fidelity check [from: bottom, to: bottom]
