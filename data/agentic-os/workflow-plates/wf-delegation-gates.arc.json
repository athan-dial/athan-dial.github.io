  "nodeData": {
    "contract": {
      "name": "Shaped contract",
      "color": "zinc",
      "icon": "ScrollText",
      "shape": "square",
      "subtitle": "Requirements, checks",
      "description": "Requirements with stable ids, each with an acceptance check, written by one pass."
    },
    "certify": {
      "name": "Readiness lint",
      "color": "blue",
      "icon": "ClipboardCheck",
      "shape": "rounded",
      "subtitle": "A separate pass",
      "description": "A different pass reads the contract cold and returns ready, needs repair or blocked. The pass that wrote the contract never certifies it."
    },
    "ready": {
      "name": "Ready?",
      "color": "blue",
      "icon": "GitFork",
      "shape": "diamond",
      "description": "Yes only if the certification is tied to the current wording and the explicit policy gates pass, which can include an instruction from a person. An agent may promote work to ready then, and cannot mark it finished, merge it or publish it."
    },
    "admit": {
      "name": "Pick up",
      "color": "blue",
      "icon": "DoorOpen",
      "shape": "rounded",
      "subtitle": "Fixed check, no judgment",
      "description": "When a builder is about to start, a fixed rule re-checks that the work is still marked ready (a material edit to the contract removes that mark), nothing it depends on is unfinished and attempts remain. No judgment call is made here."
    },
    "build": {
      "name": "Build in isolation",
      "color": "emerald",
      "icon": "Code",
      "shape": "rounded",
      "subtitle": "Own working copy",
      "description": "A builder works in its own copy of the project and records evidence against each requirement id as it goes."
    },
    "review": {
      "name": "Independent review",
      "color": "blue",
      "icon": "ScanSearch",
      "shape": "rounded",
      "subtitle": "Not the builder",
      "description": "A reviewer who did not build the work checks the diff against the project standards and the spec."
    },
    "verify": {
      "name": "Evidence meets contract?",
      "color": "blue",
      "icon": "GitFork",
      "shape": "diamond",
      "description": "Each requirement is checked against recorded evidence. A requirement with no evidence counts as unmet, not as passed."
    },
    "accept": {
      "name": "Person finishes",
      "color": "amber",
      "icon": "UserRoundCheck",
      "shape": "pill",
      "subtitle": "Finish, merge, publish",
      "description": "Marking the work finished, merging it and publishing it stay with a person, who reads the evidence first."
    },
    "escalate": {
      "name": "Person rules",
      "color": "amber",
      "icon": "UserRound",
      "shape": "pill",
      "subtitle": "Waiting or contradictory",
      "description": "When attempts run out, or the contract contradicts itself, the work waits for a person, who decides: amend the contract, narrow the scope or drop the work."
    }
  },
