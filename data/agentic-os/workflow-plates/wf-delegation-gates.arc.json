  "nodeData": {
    "contract": {
      "name": "Shaped contract",
      "color": "zinc",
      "icon": "ScrollText",
      "shape": "square",
      "subtitle": "Requirements, checks",
      "description": "Requirements with stable ids, each with an acceptance check, written by one pass."
    },
    "certify": {
      "name": "Readiness lint",
      "color": "blue",
      "icon": "ClipboardCheck",
      "shape": "rounded",
      "subtitle": "A separate pass",
      "description": "A different pass reads the contract fresh and returns ready, needs repair or blocked. The pass that wrote the contract never certifies it."
    },
    "ready": {
      "name": "Ready?",
      "color": "blue",
      "icon": "GitFork",
      "shape": "diamond",
      "description": "Yes only if the certification matches the current text of the contract and every explicit policy gate passes. An agent may promote work to ready at that point. Done, merge and publish stay with a person."
    },
    "admit": {
      "name": "Admit",
      "color": "blue",
      "icon": "DoorOpen",
      "shape": "rounded",
      "subtitle": "Deterministic",
      "description": "A fixed check admits the work: ready, still certified, nothing it needs is blocked. No judgment call is made here."
    },
    "build": {
      "name": "Build in isolation",
      "color": "emerald",
      "icon": "Code",
      "shape": "rounded",
      "subtitle": "Own working copy",
      "description": "A builder works in its own copy and records evidence against each requirement id as it goes."
    },
    "review": {
      "name": "Independent review",
      "color": "blue",
      "icon": "ScanSearch",
      "shape": "rounded",
      "description": "A reviewer who did not build the work checks the diff against the standards and the contract."
    },
    "verify": {
      "name": "Evidence meets contract?",
      "color": "blue",
      "icon": "GitFork",
      "shape": "diamond",
      "description": "Each requirement is checked against recorded evidence. A requirement with no evidence counts as unmet, not as passed."
    },
    "accept": {
      "name": "Person accepts",
      "color": "amber",
      "icon": "UserRoundCheck",
      "shape": "pill",
      "subtitle": "Done, merge, publish",
      "description": "Accepting the work, merging it and publishing it stay with a person, who reads the evidence first."
    },
    "escalate": {
      "name": "Person rules",
      "color": "amber",
      "icon": "UserRound",
      "shape": "pill",
      "subtitle": "Stuck or out of contract",
      "description": "After the retry limit, or when the contract itself is wrong, a person decides: amend the contract, narrow the scope or drop the work."
    }
  },
