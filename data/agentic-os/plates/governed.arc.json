  "nodeData": {
    "contract": {
      "name": "Shaped contract",
      "color": "zinc",
      "icon": "ScrollText",
      "shape": "square",
      "description": "A written contract with acceptance criteria, authored by one party."
    },
    "certify": {
      "name": "Readiness check",
      "color": "blue",
      "icon": "ClipboardCheck",
      "shape": "rounded",
      "subtitle": "A separate certifier",
      "description": "A different pass reads the contract fresh and certifies it. Shaping and certifying never share one pass."
    },
    "certified": {
      "name": "Certified?",
      "color": "blue",
      "icon": "GitFork",
      "shape": "diamond",
      "description": "Yes only if the certification still matches the current text of the contract."
    },
    "admit": {
      "name": "Admit",
      "color": "blue",
      "icon": "DoorOpen",
      "shape": "rounded",
      "subtitle": "Deterministic",
      "description": "Fixed predicates, no model judgment: ready state, one executor, no hold, blockers done."
    },
    "dispatch": {
      "name": "Dispatch",
      "color": "emerald",
      "icon": "Workflow",
      "shape": "rounded",
      "subtitle": "Bounded",
      "description": "The supervisor starts one executor in an isolated working copy. It enforces transitions; it builds nothing."
    },
    "execute": {
      "name": "Execute",
      "color": "emerald",
      "icon": "Bot",
      "shape": "rounded",
      "description": "The executor implements the contract in the working copy."
    },
    "evidence": {
      "name": "Evidence package",
      "color": "zinc",
      "icon": "FileCheck",
      "shape": "square",
      "description": "Diff, test output and a mapping from each criterion to its proof."
    },
    "review": {
      "name": "Independent review",
      "color": "blue",
      "icon": "ScanSearch",
      "shape": "rounded",
      "description": "A reviewer other than the executor."
    },
    "verify": {
      "name": "Meets contract?",
      "color": "blue",
      "icon": "GitFork",
      "shape": "diamond",
      "description": "Build and evidence are checked against the contract as it was admitted."
    },
    "human": {
      "name": "Human closure",
      "color": "amber",
      "icon": "UserRoundCheck",
      "shape": "pill",
      "subtitle": "Accept, merge, publish",
      "description": "Marking work done, merging and publishing are reserved for a person."
    }
  },
