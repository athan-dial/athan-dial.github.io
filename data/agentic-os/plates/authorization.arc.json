  "nodeData": {
    "propose": {
      "name": "Agent proposes an action",
      "color": "emerald",
      "icon": "Bot",
      "shape": "rounded",
      "description": "Reading, searching, editing a working copy and running local checks need no extra approval."
    },
    "local": {
      "name": "Reversible?",
      "color": "blue",
      "icon": "GitFork",
      "shape": "diamond",
      "description": "Can the action be undone, and does it stay on this machine?"
    },
    "proceed": {
      "name": "Proceed within the task",
      "color": "emerald",
      "icon": "Play",
      "shape": "rounded",
      "description": "Reversible local work goes ahead and is recorded."
    },
    "reserved": {
      "name": "Reserved for a person",
      "color": "zinc",
      "icon": "Lock",
      "shape": "square",
      "description": "Push, merge, deploy, publish, send a message, spend money, use credentials, mark work done, change standing instructions."
    },
    "draft": {
      "name": "Draft and hold",
      "color": "emerald",
      "icon": "FilePen",
      "shape": "rounded",
      "description": "The agent prepares the item (a draft message, a pull request) and stops."
    },
    "decide": {
      "name": "Human decision",
      "color": "amber",
      "icon": "UserRoundCheck",
      "shape": "pill",
      "description": "Approve this item, ask for changes, or stop."
    },
    "stop": {
      "name": "Stop and record why",
      "color": "zinc",
      "icon": "OctagonX",
      "shape": "square",
      "description": "Nothing goes out. The reason is kept."
    },
    "act": {
      "name": "Act once, as approved",
      "color": "emerald",
      "icon": "Check",
      "shape": "rounded",
      "description": "The approval covers that specific item, not the next one."
    },
    "record": {
      "name": "Record the outcome",
      "color": "zinc",
      "icon": "NotebookPen",
      "shape": "square",
      "description": "What ran and what was approved, written to the work ledger."
    }
  },
