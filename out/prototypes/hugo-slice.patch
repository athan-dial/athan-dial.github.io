diff --git a/layouts/atlas/list.html b/layouts/atlas/list.html
new file mode 100644
index 0000000..4940318
--- /dev/null
+++ b/layouts/atlas/list.html
@@ -0,0 +1,18 @@
+{{ define "main" }}
+<section class="container atlas" data-atlas>
+  <h1>{{ .Title }}</h1>
+  <p class="body-lg">{{ .Description }}</p>
+  <div class="atlas__controls" data-atlas-controls hidden>
+    <label>Search<input type="search" data-atlas-search placeholder="Title, summary, tag"></label>
+    <label>Domain<select data-atlas-filter="domain"><option value="">All</option>{{ range slice "Data" "Product" "Systems" "Writing" }}<option>{{ . }}</option>{{ end }}</select></label>
+    <label>Status<select data-atlas-filter="status"><option value="">All</option>{{ range slice "Shipped" "In progress" "Archived" }}<option>{{ . }}</option>{{ end }}</select></label>
+  </div>
+  <p class="atlas__count" data-atlas-count role="status">{{ len .Pages }} of {{ len .Pages }} records</p>
+  <ul class="atlas__list">
+    {{- range .Pages.ByParam "id" }}
+    <li data-atlas-item data-domain="{{ .Params.domain }}" data-status="{{ .Params.lifecycle }}" data-text="{{ lower (printf "%s %s %s" .Title .Params.summary (delimit .Params.tags " ")) }}">{{ partial "atlas-card.html" . }}</li>
+    {{- end }}
+  </ul>
+  <p class="atlas__empty" data-atlas-empty hidden role="status">No records match.</p>
+</section>
+{{ end }}
