+{{ define "main" }}
+<div class="container">
+<article class="atlas-detail">
+  <a href="{{ "/atlas/" | relURL }}">&larr; All records</a>
+  <h1>{{ .Title }}</h1>
+  <dl>
+    <dt>ID</dt><dd>{{ .Params.id }}</dd>
+    <dt>Domain</dt><dd>{{ .Params.domain }}</dd>
+    <dt>Status</dt><dd>{{ .Params.lifecycle }}</dd>
+    <dt>Year</dt><dd>{{ .Params.year }}</dd>
+    <dt>Tags</dt><dd>{{ delimit .Params.tags ", " }}</dd>
+  </dl>
+  {{ .Content }}
+</article>
+</div>
+{{ end }}
