diff --git a/assets/css/atlas.css b/assets/css/atlas.css
new file mode 100644
index 0000000..0d7fa96
--- /dev/null
+++ b/assets/css/atlas.css
@@ -0,0 +1,23 @@
+/* Slice-only styles. Consumes tokens.css only; no new hex. */
+.atlas { padding-block: 48px; }
+.atlas__controls { display: flex; flex-wrap: wrap; gap: 16px; margin-block: 24px; align-items: end; }
+.atlas__controls label { display: grid; gap: 4px; font-family: var(--font-mono); font-size: var(--label-mono-size); }
+.atlas__controls input, .atlas__controls select { font: inherit; padding: 8px 10px; border: 1px solid var(--rule); background: var(--surface); color: var(--ink); min-width: 180px; }
+.atlas__controls input:focus-visible, .atlas__controls select:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+.atlas__controls[hidden], .atlas__empty[hidden] { display: none; }
+.atlas__count { font-family: var(--font-mono); font-size: var(--label-mono-size); color: var(--ink-secondary); }
+.atlas__list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--field-rule); }
+.atlas__list > li { border-bottom: 1px solid var(--field-rule); }
+.atlas__list > li[hidden] { display: none; }
+.atlas-card { display: grid; gap: 8px; padding: 20px 0; }
+.atlas-card__meta { display: flex; flex-wrap: wrap; gap: 8px 16px; font-family: var(--font-mono); font-size: var(--label-mono-size); color: var(--ink-secondary); }
+.atlas-card__title { margin: 0; font-size: var(--headline-sm-size); line-height: var(--headline-sm-line-height); }
+.atlas-card__title a { color: var(--ink); text-decoration-color: var(--accent); text-underline-offset: 4px; }
+.atlas-card__title a:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
+.atlas-card__summary { margin: 0; color: var(--ink-secondary); max-width: var(--reading-column); }
+.atlas__empty { padding: 24px 0; color: var(--ink-secondary); }
+.atlas-detail { max-width: var(--reading-column); padding-block: 48px; }
+.atlas-detail dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 20px; font-family: var(--font-mono); font-size: var(--label-mono-size); }
+.atlas-detail dt { color: var(--ink-secondary); }
+.atlas-detail dd { margin: 0; }
+@media (max-width: 600px) { .atlas__controls input, .atlas__controls select { min-width: 0; width: 100%; } .atlas__controls label { flex: 1 1 100%; } }
diff --git a/assets/js/atlas.js b/assets/js/atlas.js
new file mode 100644
index 0000000..058df17
--- /dev/null
+++ b/assets/js/atlas.js
@@ -0,0 +1,25 @@
+// Shared by both prototypes. Progressive enhancement only: the list is complete without it.
+(() => {
+  const root = document.querySelector('[data-atlas]');
+  if (!root) return;
+  const q = root.querySelector('[data-atlas-search]');
+  const selects = [...root.querySelectorAll('[data-atlas-filter]')];
+  const items = [...root.querySelectorAll('[data-atlas-item]')];
+  const count = root.querySelector('[data-atlas-count]');
+  const empty = root.querySelector('[data-atlas-empty]');
+  root.querySelectorAll('[data-atlas-controls]').forEach((c) => (c.hidden = false));
+  const apply = () => {
+    const term = q.value.trim().toLowerCase();
+    let shown = 0;
+    for (const li of items) {
+      const okText = !term || li.dataset.text.includes(term);
+      const okFilter = selects.every((s) => !s.value || li.dataset[s.dataset.atlasFilter] === s.value);
+      li.hidden = !(okText && okFilter);
+      if (!li.hidden) shown++;
+    }
+    count.textContent = `${shown} of ${items.length} records`;
+    empty.hidden = shown !== 0;
+  };
+  q.addEventListener('input', apply);
+  selects.forEach((s) => s.addEventListener('change', apply));
+})();
diff --git a/content/atlas/_content.gotmpl b/content/atlas/_content.gotmpl
new file mode 100644
index 0000000..263583b
--- /dev/null
+++ b/content/atlas/_content.gotmpl
@@ -0,0 +1,20 @@
+{{- /* Generate one page per record in data/atlas_sample.json, validating each. */ -}}
+{{- $domains := slice "Data" "Product" "Systems" "Writing" -}}
+{{- $statuses := slice "Shipped" "In progress" "Archived" -}}
+{{- range site.Data.atlas_sample -}}
+  {{- $r := . -}}
+  {{- range slice "id" "slug" "title" "summary" "domain" "status" "year" "body" -}}
+    {{- if not (isset $r .) }}{{ errorf "atlas record %v: missing required field %q" $r.id . }}{{ end -}}
+  {{- end -}}
+  {{- if not (in $domains .domain) }}{{ errorf "atlas record %s: domain %q not in %v" .id .domain $domains }}{{ end -}}
+  {{- if not (in $statuses .status) }}{{ errorf "atlas record %s: status %q not in %v" .id .status $statuses }}{{ end -}}
+  {{- if not (eq (printf "%T" .year) "float64") }}{{ errorf "atlas record %s: year must be a number" .id }}{{ end -}}
+  {{- $.AddPage (dict
+    "path" .slug
+    "title" .title
+    "description" .summary
+    "kind" "page"
+    "content" (dict "mediaType" "text/markdown" "value" .body)
+    "params" (dict "id" .id "domain" .domain "lifecycle" .status "status" "published" "visibility" "public" "year" (int .year) "tags" .tags "summary" .summary)
+  ) -}}
+{{- end -}}
