---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
export async function getStaticPaths() {
  return (await getCollection('atlas')).map((r) => ({ params: { slug: r.id }, props: { r } }));
}
const { r } = Astro.props;
const d = r.data;
---
<Base title={d.title} description={d.summary}>
  <div class="container">
    <article class="atlas-detail">
      <a href="/atlas/">&larr; All records</a>
      <h1>{d.title}</h1>
      <dl>
        <dt>ID</dt><dd>{d.recordId}</dd>
        <dt>Domain</dt><dd>{d.domain}</dd>
        <dt>Status</dt><dd>{d.status}</dd>
        <dt>Year</dt><dd>{d.year}</dd>
        <dt>Tags</dt><dd>{d.tags.join(', ')}</dd>
      </dl>
      <p>{d.body}</p>
    </article>
  </div>
</Base>
