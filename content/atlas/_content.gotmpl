{{- /* One page per atlas/records/*.toml, read through the data/atlas symlink. Fails the build on a malformed record. */ -}}
{{- range $slug, $r := site.Data.atlas -}}
  {{- range slice "schema_version" "id" "canonical_url" "title" "topic" "mechanism" "evidence_state" "status" "last_review_date" "opinion" "sources" "facts" -}}
    {{- if not (isset $r .) }}{{ errorf "atlas record %s: missing required field %q" $slug . }}{{ end -}}
  {{- end -}}
  {{- if or (findRE `^S[0-9]+$` (string $r.id)) (hasPrefix $slug "sample-") }}{{ errorf "atlas record %s: synthetic sample record cannot ship" $slug }}{{ end -}}
  {{- if not (hasPrefix $r.id "github:") }}{{ errorf "atlas record %s: id must be github:owner/repo" $slug }}{{ end -}}
  {{- if ne $r.schema_version "atlas-record/1" }}{{ errorf "atlas record %s: unsupported schema_version %q" $slug $r.schema_version }}{{ end -}}
  {{- $body := printf "%s\n\n## Value judgment\n\n%s\n\n## Limitations\n\n" $r.mechanism $r.opinion.value_judgment -}}
  {{- range $r.opinion.limitations }}{{ $body = printf "%s- %s\n" $body . }}{{ end -}}
  {{- $body = printf "%s\n## Facts\n\n" $body -}}
  {{- range $r.facts }}{{ $body = printf "%s- %s ([source](%s))\n" $body .claim .source_url }}{{ end -}}
  {{- $body = printf "%s\n## Sources\n\n" $body -}}
  {{- range $r.sources }}{{ $body = printf "%s- <%s> (%s, accessed %s)\n" $body .url .kind .accessed }}{{ end -}}
  {{- $.AddPage (dict
    "path" $slug
    "title" $r.title
    "description" $r.mechanism
    "kind" "page"
    "content" (dict "mediaType" "text/markdown" "value" $body)
    "params" (dict "id" $r.id "topic" $r.topic "evidence" $r.evidence_state "lifecycle" $r.status "license" (default "" $r.license_spdx) "canonical_url" $r.canonical_url "reviewed" $r.last_review_date "summary" $r.mechanism "status" "published" "visibility" "public")
  ) -}}
{{- end -}}
